# ---- Application ----
NODE_ENV=development
APP_HOST=localhost
APP_PORT=3000

# ---- PostgreSQL (docker container) ----
POSTGRES_CONTAINER=finance-postgres
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance-db
POSTGRES_SCHEMA=finance-schema
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://finance_app:change-me@localhost:5432/finance-db

# ---- Documentation ----
# ON  = Claude updates /documentation/*.puml and README.md as the app evolves
# OFF = documentation is left untouched
DOCUMENTATION_UPDATE=ON

# ---- Twelve Data (market data reference) ----
TWELVE_DATA_API_KEY=your-twelve-data-api-key
TWELVE_DATA_BASE_URL=https://api.twelvedata.com
# Catalog scope: country filter for /stocks and /etfs; refresh interval at server start
TWELVE_DATA_COUNTRY="United States"
TICKER_CATALOG_TTL_HOURS=24
# Market prices (Twelve Data /price): seconds to reuse a fetched price (free plan: 8 requests/min)
PRICE_CACHE_SECONDS=60
